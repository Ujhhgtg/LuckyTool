<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/prefs_card"
        android:clickable="true"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:animateLayoutChanges="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:paddingHorizontal="6dp"
            android:orientation="vertical">
        
        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/prefs_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="8dp"
                android:animateLayoutChanges="true">
            
            <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/prefs_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:visibility="gone"
                    android:scaleType="centerCrop"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:shapeAppearanceOverlay="?attr/shapeAppearanceMediumComponent" />
            
            <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/prefs_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:ellipsize="end"
                    app:layout_constraintBottom_toTopOf="@+id/prefs_summary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/prefs_icon"
                    app:layout_constraintTop_toTopOf="parent" />
            
            <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/prefs_summary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:ellipsize="end"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/prefs_icon"
                    app:layout_constraintTop_toBottomOf="@+id/prefs_title" />
        
        </androidx.constraintlayout.widget.ConstraintLayout>
        
        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/prefs_recycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone" />
    
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>